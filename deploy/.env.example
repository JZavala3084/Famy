# Copia este archivo como .env junto al docker-compose de producción. Sin valores reales en el repo.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/famy
SPRING_DATASOURCE_USERNAME=famy
DB_PASSWORD=
# Clave EC P-256 en PEM PKCS#8:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out secrets/jwt-private.pem
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Famy <no-reply@tu-dominio>
APP_BASE_URL=https://famy.tu-dominio
CORS_ALLOWED_ORIGINS=https://famy.tu-dominio
